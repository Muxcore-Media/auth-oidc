AUTH_OIDC_ISSUER=
# Optional module — default stacks use auth-local. Leave issuer empty to soft-fail
# (module starts; /login returns 503 until IdP is set). For local Keycloak:
#   KEYCLOAK_HOST_PORT=18080 docker compose -f deploy/docker-compose.yml up -d
#   AUTH_OIDC_ISSUER=http://127.0.0.1:18080/realms/muxcore
# AUTH_OIDC_ISSUER=https://authentik.example.com/application/o/muxcore/
AUTH_OIDC_CLIENT_ID=muxcore
AUTH_OIDC_CLIENT_SECRET=replace-me
AUTH_OIDC_REDIRECT_URL=http://localhost:9412/oidc/callback
AUTH_OIDC_GRPC_ADDR=:9410
AUTH_OIDC_HTTP_ADDR=:9412
AUTH_OIDC_POLICY_FILE=policies.yaml
AUTH_OIDC_ROLES_CLAIM=groups
# Optional: map IdP group/role names to local RBAC roles (comma-separated IdP=local)
# AUTH_OIDC_ROLE_MAP=muxcore-admins=admin,muxcore-users=user
# AUTH_OIDC_DEFAULT_ROLES=user
MUXCORE_INSECURE_DISABLE_TLS=true
